    {
      "item": "Membership",
      "reviewed": true,
      "intent": "Record how a resolved note reached a location: DirectoryScope (pulled in by directory-subtree cascade) or See (pulled in explicitly by an @liyi:see reference). Used to label and prioritize notes in output; carries no tracking semantics.",
      "source_span": [
        30,
        35
      ],
      "tree_path": "enum.Membership",
      "source_hash": "sha256:e810868505f25e1d7fd9a2c386df6792ce4aa6f212b7d04614d42622fddd4c9b",
      "source_anchor": "pub enum Membership {"
    },
    {
      "item": "Note",
      "reviewed": true,
      "intent": "A single note discovered by live scan: its optional group-label name, the repo-relative file it lives in, the 1-indexed [opener, closer] line span, and the governing prose between the markers. Must hold no hash, review flag, or any other staleness-tracking field — notes are untracked context.",
      "source_span": [
        39,
        48
      ],
      "tree_path": "struct.Note",
      "source_hash": "sha256:4bfe9cabc106fbc7f026c1d41f597a8dbbe2e75ff4b48ed360ed0e15028ebe25",
      "source_anchor": "pub struct Note {"
    },
