    },
    {
      "item": "extract_note_blocks",
      "reviewed": true,
      "intent": "Pair @liyi:note openers with @liyi:end-note closers within one file's scanned markers and return the resulting notes. A closer binds to the nearest open of identical name (anonymous to anonymous). An opener with no matching closer extends to end-of-file (the dedicated-file case). Prose is the text strictly between opener and closer lines, trimmed. Must not read or emit any hash or sidecar state.",
      "source_span": [
        99,
        149
      ],
      "tree_path": "fn.extract_note_blocks",
      "source_hash": "sha256:fa4cdf83c9e15e225dbe8ea0b49539640530e1926d0da41390c1af88465be18f",
      "source_anchor": "fn extract_note_blocks(content: &str, source: &str) -> Vec<Note> {"
    },
    {
      "item": "collect_notes",
      "reviewed": true,
      "intent": "Walk the working tree rooted at `root` (respecting .gitignore/.liyiignore and skipping VCS dirs), scan every note file (per is_note_file) for note blocks, and return all notes with repo-relative source paths. Pure live scan: reads no sidecars, computes no hashes.",
      "source_span": [
        153,
        189
      ],
      "tree_path": "fn.collect_notes",
      "source_hash": "sha256:c68ff66e5cc4fcee312fadc016364211642d2fde914bde1b91cb3f28a1f9d277",
      "source_anchor": "pub fn collect_notes(root: &Path) -> Vec<Note> {",
      "related": {
        "note-is-untracked": "sha256:60d2cd16faf066360e7c4d7814aedcdc4728fe01ebcf697fe266e81d4000b365"
      }
    },
    {
      "item": "collect_see",
      "reviewed": true,
      "intent": "Scan the target file for @liyi:see markers and return the referenced note names together with a flag indicating whether the opt-out sentinel (=none) is present. MVP is file-scoped: every @liyi:see in the file contributes. The =none sentinel is reported separately and is never returned as a name.",
      "source_span": [
        194,
        207
      ],
      "tree_path": "fn.collect_see",
      "source_hash": "sha256:9b469db95d9c7e517d0cf2fa3d0d1662421aef27b6cef3e8461cfbbc3ca855b3",
      "source_anchor": "fn collect_see(content: &str) -> (Vec<String>, bool) {"
    },
    {
      "item": "resolve",
      "reviewed": true,
      "intent": "Resolve the notes applicable to a repo-relative target via live scan: directory-scope notes from each ancestor directory with nearest-wins shadowing by name (anonymous notes shadow as a group), plus all notes named by the file's @liyi:see references. An @liyi:see =none opt-out suppresses directory-scope notes but never the explicitly see-referenced ones. Each note appears once; results are ordered deterministically by (source path, span start). Reads no sidecar and computes no hash.",
      "source_span": [
        217,
        289
      ],
      "tree_path": "fn.resolve",
      "source_hash": "sha256:db4e502c6ffa75879e027a1d36c480bf3e52571e4ca317823031d0e474ec30fd",
      "source_anchor": "pub fn resolve(root: &Path, target_rel: &str) -> Vec<ResolvedNote> {",
      "related": {
        "context-resolution": "sha256:2943bf58b0f14391c9ee0d55f643b4dadffa088c0a668c5a6acbf134ee8c27a8",
        "note-directory-scope": "sha256:288cb675a9beb1ac864f5208171df3a2788dd3e06e47f153d1d9681f76e8be1d"
      }
    },
    {
      "item": "render",
      "reviewed": false,
      "intent": "Format resolved notes as the human/agent-readable report: one block per note headed by its name (or an unnamed-note placeholder), annotated with `(via @liyi:see)` when reached by membership, and tagged with the source path, followed by the prose. Emit a clear no-notes message when the list is empty. Output ordering must follow the input order so determinism from resolve is preserved.",
      "source_span": [
        292,
        311
      ],
      "tree_path": "fn.render",
      "source_hash": "sha256:50a5c675ffb1288c9ca19c6557db00549a264bb141cb30c8dfdab21fe667ce38",
      "source_anchor": "pub fn render(notes: &[ResolvedNote]) -> String {"
    },
