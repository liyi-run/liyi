    {
      "item": "ancestor_dirs",
      "reviewed": true,
      "intent": "Return the ancestor directories of a repo-relative path ordered nearest-first and ending at the repo root (empty string). Order is significant: it drives nearest-wins shadowing in directory-scope resolution. For a path directly in the root, returns just [\"\"].",
      "source_span": [
        77,
        85
      ],
      "tree_path": "fn.ancestor_dirs",
      "source_hash": "sha256:54895f2ba0d6de002a50dffb8afd36d6d300effcc78f3675263800c4ad1b5dbc",
      "source_anchor": "fn ancestor_dirs(rel: &str) -> Vec<String> {"
    },
