    {
      "item": "is_note_file",
      "reviewed": true,
      "intent": "Decide whether a filename may carry notes in the MVP gate: true only for a dedicated LIYI.md or any README*.md (README.md or README.<suffix>.md). This is the filename half of the marker gate; a matching file still contributes nothing unless it carries a @liyi:note marker.",
      "source_span": [
        60,
        64
      ],
      "tree_path": "fn.is_note_file",
      "source_hash": "sha256:1c387d164ec989d5bc3e678c7353c574d389a93606a0d6b756526e42f2c5b41d",
      "source_anchor": "fn is_note_file(name: &str) -> bool {",
      "related": {
        "note-directory-scope": "sha256:288cb675a9beb1ac864f5208171df3a2788dd3e06e47f153d1d9681f76e8be1d"
      }
    },
    {
