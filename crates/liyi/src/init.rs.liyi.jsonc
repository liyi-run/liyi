    {
      "item": "init_agents_md",
      "reviewed": true,
      "intent": "Create AGENTS.md when absent, writing `# AGENTS.md` plus the portable agent-instruction block. When the file already contains such a block, return AlreadyExists unless force is set, in which case replace the existing block with the current revision; when the file exists without a block, append it after a blank line. Must key off the block pragma, never the section heading.",
      "source_span": [
        125,
        152
      ],
