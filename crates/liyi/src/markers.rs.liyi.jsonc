    {
      "item": "SourceMarker",
      "reviewed": true,
      "intent": "Enumerate all recognized @liyi: marker types (Note, EndNote, See, Requirement, EndRequirement, Related, Intent, Trivial, Ignore, Nontrivial) with their associated data. Note/EndNote carry an optional group-label name; See carries a required target name (including the =none opt-out sentinel); Requirement/EndRequirement/Related carry a name; Intent carries optional prose and an is_doc flag. Every variant carries a 1-indexed line number.",
      "source_span": [
        7,
        53
      ],
      "tree_path": "enum.SourceMarker",
      "source_hash": "sha256:12920c063c258b88f4f2f0b2d48d5e57cc25d9743604e80d3f31b77576bb043c",
      "source_anchor": "pub enum SourceMarker {"
    },
    {
