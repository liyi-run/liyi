      "source_anchor": "fn extract_see_target(rest: &str) -> Option<String> {"
    },
    {
      "item": "scan_markers",
      "reviewed": true,
      "intent": "Scan all lines of a source file, normalize each line for full-width characters, and return a list of SourceMarker values for every recognized @liyi: marker found. Line numbers are 1-indexed. Markers inside fenced code blocks, inline backtick spans, quoted spans, or immediately after quotation marks are suppressed (NL-quoting). Handles the =doc sentinel for intent markers.",
