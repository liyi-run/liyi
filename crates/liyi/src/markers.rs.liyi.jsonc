    {
      "item": "extract_name",
      "reviewed": true,
      "intent": "Extract a name argument from the text after a marker keyword: if the first non-whitespace character is '(', take the content up to the matching ')'; otherwise take the first whitespace-delimited token. Return None if no name is present or if the name exceeds MAX_NAME_LEN bytes (security: bounds attacker-controlled text in --prompt output).",
      "source_span": [
        133,
        153
      ],
      "tree_path": "fn.extract_name",
      "source_hash": "sha256:82f1ce7a581c8d01e063fb6a65c28da907d5256c006eaf53a540c2a3c13a2a06",
      "source_anchor": "fn extract_name(rest: &str) -> Option<String> {"
    },
    {
      "item": "extract_label",
      "reviewed": true,
      "intent": "Extract an optional group label following a @liyi:note or @liyi:end-note marker. Return the first whitespace-delimited token only when it begins with an alphanumeric character; return None otherwise. This deliberately rejects trailing comment terminators (such as --> or */) so a label-less note like '<!-- @liyi:note -->' is treated as anonymous rather than capturing the closer as its name. Reject names exceeding MAX_NAME_LEN bytes.",
      "source_span": [
        162,
        171
      ],
      "tree_path": "fn.extract_label",
      "source_hash": "sha256:27c0b6b06aecea77f7524d549346b620c79caa11c57b0d22fbd1ae907321aec4",
      "source_anchor": "fn extract_label(rest: &str) -> Option<String> {"
    },
    {
      "item": "extract_see_target",
      "reviewed": true,
      "intent": "Extract the target name of a @liyi:see marker. Like extract_label, but additionally accept the =none opt-out sentinel (and any future =-prefixed sentinel) by allowing a leading '=' in addition to an alphanumeric first character, while still rejecting comment terminators. Reject names exceeding MAX_NAME_LEN bytes.",
      "source_span": [
        176,
        186
