    {
      "item": "objc_node_name",
      "reviewed": true,
      "intent": "Custom name extractor for Objective-C AST nodes: delegate function_definition to c_extract_declarator_name; extract the base class/implementation/protocol name from the first identifier/type_identifier child, and for category blocks (`@interface Foo (Cat)` / `@implementation Foo (Cat)`, which carry a `category` field) encode the name as `Foo (Cat)` so categories do not collide with the base class on the same tree_path; compose method selector names from keyword_declarator children (multi-part selectors) or a single identifier (zero-argument methods). Return None for unrecognized kinds.",
      "source_span": [
        14,
        79
      ],
      "tree_path": "fn.objc_node_name",
